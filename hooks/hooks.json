{
  "description": "ghostimport: block installs and npx/dlx/create runs of packages that don't exist or look malicious, and flag non-existent imports right after an edit. Fails open when the registry is unreachable.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
