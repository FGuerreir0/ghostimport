{
  "name": "ghostimport",
  "version": "0.5.1",
  "description": "Stops AI coding agents from installing npm packages that don't exist. MCP server + hooks that block slopsquatting and typosquat supply-chain attacks.",
  "keywords": [
    "npm",
    "ai",
    "mcp",
    "mcp-server",
    "slopsquatting",
    "typosquatting",
    "hallucination",
    "vibe-coding",
    "cursor",
    "claude",
    "claude-code",
    "agent",
    "imports",
    "security",
    "lint",
    "ghost",
    "import-validation",
    "ai-safety",
    "supply-chain",
    "supply-chain-security",
    "hallucination-detection",
    "copilot",
    "pre-commit"
  ],
  "homepage": "https://fguerreir0.github.io/ghostimport/",
  "bugs": {
    "url": "https://github.com/FGuerreir0/ghostimport/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FGuerreir0/ghostimport.git"
  },
  "license": "MIT",
  "author": "Fábio Guerreiro",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "ghostimport": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.js",
    "typecheck": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "tsx tests/test.ts",
    "dev": "tsx src/cli.ts",
    "prepare": "git config core.hooksPath .githooks",
    "prepublishOnly": "npm run build",
    "release": "pwsh -File deploy.ps1",
    "release:minor": "pwsh -File deploy.ps1 -Bump minor",
    "release:major": "pwsh -File deploy.ps1 -Bump major"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
